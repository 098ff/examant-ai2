# ==============================================================================
# ExamAnt Environment Configuration (.env.example)
# Copy this file to `.env` before running `docker compose up --build`
# ==============================================================================

# --- Host Port Mapping (Adjust if a port is already in use on macOS/Windows) ---
# MongoDB host port (Default 27018 to avoid colliding with local MongoDB on 27017)
MONGO_PORT=27018

# FastAPI Backend host port (Avoid 5000/7000 on macOS due to AirPlay Receiver)
BACKEND_PORT=8000

# Streamlit Frontend host port
FRONTEND_PORT=8501

# --- MongoDB Configuration ---
MONGO_INITDB_DATABASE=examant_db
MONGO_URI=mongodb://mongodb:27017
MONGO_DB_NAME=examant_db

# Local MongoDB URI (Used when running Python scripts directly on host outside Docker)
LOCAL_MONGO_URI=mongodb://localhost:27018

# --- Frontend -> Backend Communication ---
# Inside Docker network, frontend reaches backend via service name `http://backend:8000`
BACKEND_API_URL=http://backend:8000
